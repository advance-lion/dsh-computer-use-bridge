{
  "name": "dsh-desktop-bridge",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Desktop fallback bridge: one serialized Computer Use delegation tool for every DSH session.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/coordinator.js",
    "lib/control-channel.js",
    "lib/orb-compat.js",
    "lib/trigger.js",
    "lib/worker-session.js",
    "lib/task-gate.js",
    "lib/stop-shortcut.js",
    "lib/stop-shortcut-helper.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.1"
  },
  "peerDependencies": {
    "dsh-orb": ">=0.2.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "dsh-orb": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
